# ══════════════════════════════════════════════════════════════════
# NEURO_PREDICT_SYS — Environment Configuration
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# Supabase (leave empty for demo/in-memory mode)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production

# Server
PORT=8000
DEBUG=true
