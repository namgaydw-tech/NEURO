# NEURO_PREDICT_SYS — Development Configuration
# Demo mode: no Supabase URL = in-memory storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# JWT Authentication (backend)
JWT_SECRET=neuro-predict-sys-dev-secret-key-change-in-prod

# Clerk Authentication (frontend)
# Get your publishable key from https://dashboard.clerk.com/ > API Keys
# Format: pk_test_... or pk_live_...
CLERK_PUBLISHABLE_KEY=

# Server
PORT=8000
DEBUG=true
