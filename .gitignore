# ══════════════════════════════════════════════════════════════════
# NEURO_PREDICT_SYS — .gitignore
# ══════════════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ───────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*credentials*
*secret*

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
backendvenv/
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Virtual environments ─────────────────────────────────────────
backend/venv/
NEURO/backend/venv/
stitch_neuro_ai_disease_predictorbackendvenv/

# ── IDE ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.lnk

# ── Build/output ──────────────────────────────────────────────────
dist/
build/
*.pyc
.mypy_cache/

# ── ML model artifacts (keep small metadata, exclude large files) ─
# backend/ml/models/*.pkl  # Uncomment to exclude trained models

# ── Logs ──────────────────────────────────────────────────────────
*.log
*.log.*

# ── Freebuff temporary files ──────────────────────────────────────
.freebuff/
.freebuff*/

# ── Node (if any) ────────────────────────────────────────────────
node_modules/

# ── Docker ────────────────────────────────────────────────────────
docker-compose.override.yml
